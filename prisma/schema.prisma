generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/**
 * =========================
 * ENUMS
 * =========================
 */

enum Role {
  ADMIN
  STAFF
  CLIENT
}

enum BookingStatus {
  NEW
  CONTACTED
  QUOTATION_SENT
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum FileType {
  PHOTO
  VIDEO
  DOCUMENT
  CONTRACT
  INVOICE
  OTHER
}

enum FileVisibility {
  PUBLIC
  PRIVATE
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum ContractStatus {
  DRAFT
  SENT
  SIGNED
  EXPIRED
  CANCELLED
}

enum NotificationType {
  ENQUIRY
  BOOKING_UPDATE
  FILE_AVAILABLE
  FILE_DOWNLOAD
  CONTRACT
  INVOICE
  PAYMENT
  MESSAGE
  SYSTEM
}

enum ActivityAction {
  LOGIN
  LOGOUT
  CREATE
  UPDATE
  DELETE
  UPLOAD
  DOWNLOAD
  VIEW
  STATUS_CHANGE
}

/**
 * =========================
 * USER
 * =========================
 */

model User {
  id           String  @id @default(cuid())
  name         String?
  email        String  @unique
  passwordHash String
  role         Role    @default(CLIENT)
  phone        String?
  isActive     Boolean @default(true)

  client Client?

  notifications Notification[]
  activities    ActivityLog[]
  messagesSent  Message[]      @relation("MessageSender")
  uploadedFiles File[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([email])
}

/**
 * =========================
 * CLIENT
 * =========================
 */

model Client {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  companyName String?
  address     String?
  city        String?
  province    String?
  notes       String?

  enquiries Enquiry[]
  bookings  Booking[]
  files     File[]
  contracts Contract[]
  invoices  Invoice[]
  messages  Message[]
  payments  Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyName])
}

/**
 * =========================
 * ENQUIRY
 * =========================
 */

model Enquiry {
  id String @id @default(cuid())

  reference String @unique

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  name      String
  email     String
  phone     String
  service   String
  eventType String
  eventDate DateTime?
  location  String
  message   String

  status BookingStatus @default(NEW)

  booking Booking?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([status])
  @@index([eventDate])
}

/**
 * =========================
 * BOOKING
 * =========================
 */

model Booking {
  id String @id @default(cuid())

  reference String @unique

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  enquiryId String?  @unique
  enquiry   Enquiry? @relation(fields: [enquiryId], references: [id], onDelete: SetNull)

  service   String
  eventType String
  eventDate DateTime?
  location  String?
  notes     String?

  status BookingStatus @default(NEW)

  files     File[]
  contracts Contract[]
  invoices  Invoice[]
  messages  Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([status])
  @@index([eventDate])
}

/**
 * =========================
 * FILE
 * =========================
 */

model File {
  id String @id @default(cuid())

  name         String
  originalName String
  storageKey   String @unique
  mimeType     String
  size         Int

  type       FileType
  visibility FileVisibility @default(PRIVATE)

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  bookingId String?
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  uploadedById String?
  uploadedBy   User?   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  activityLogs ActivityLog[]

  contract  Contract? @relation("ContractFile")
  invoice   Invoice?  @relation("InvoiceFile")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([clientId])
  @@index([bookingId])
  @@index([type])
}

/**
 * =========================
 * CONTRACT
 * =========================
 */

model Contract {
  id String @id @default(cuid())

  title     String
  reference String @unique

  status ContractStatus @default(DRAFT)

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  bookingId String?
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  fileId    String?   @unique
  file      File?     @relation("ContractFile", fields: [fileId], references: [id], onDelete: SetNull)
  signedAt  DateTime?
  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([status])
}

/**
 * =========================
 * INVOICE
 * =========================
 */

model Invoice {
  id String @id @default(cuid())

  invoiceNumber String @unique

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  bookingId String?
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  description String?

  subtotal Decimal @db.Decimal(12, 2)
  tax      Decimal @default(0) @db.Decimal(12, 2)
  total    Decimal @db.Decimal(12, 2)

  amountPaid Decimal @default(0) @db.Decimal(12, 2)

  currency String @default("ZAR")

  status InvoiceStatus @default(DRAFT)

  dueDate DateTime?
  paidAt  DateTime?

  fileId   String?   @unique
  file     File?     @relation("InvoiceFile", fields: [fileId], references: [id], onDelete: SetNull)
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([status])
  @@index([dueDate])
}

/**
 * =========================
 * PAYMENT
 * =========================
 */

model Payment {
  id String @id @default(cuid())

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  amount   Decimal @db.Decimal(12, 2)
  currency String  @default("ZAR")

  method               String?
  transactionReference String?

  paidAt DateTime @default(now())

  createdAt DateTime @default(now())

  @@index([invoiceId])
  @@index([clientId])
}

/**
 * =========================
 * MESSAGE
 * =========================
 */

model Message {
  id String @id @default(cuid())

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  bookingId String?
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  senderId String
  sender   User   @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  content String

  readAt DateTime?

  createdAt DateTime @default(now())

  @@index([clientId])
  @@index([bookingId])
  @@index([senderId])
}

/**
 * =========================
 * NOTIFICATION
 * =========================
 */

model Notification {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    NotificationType
  title   String
  message String

  readAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([readAt])
  @@index([createdAt])
}

/**
 * =========================
 * ACTIVITY LOG
 * =========================
 */

model ActivityLog {
  id String @id @default(cuid())

  action ActivityAction

  description String?

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  fileId String?
  file   File?   @relation(fields: [fileId], references: [id], onDelete: SetNull)

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([fileId])
  @@index([action])
  @@index([createdAt])
}
